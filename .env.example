NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost
PUBLIC_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
AGENT_RUNTIME=python
PYTHON_AGENT_URL=http://localhost:8002
PYTHON_AGENT_TIMEOUT_SECONDS=240
HTTP_PORT=80

# Local MVP defaults. JSON store is best for zero-setup demos.
LOCAL_DATA_DIR=./data
LOCAL_UPLOAD_DIR=./uploads
LOCAL_RENDER_DIR=./rendered

# Storage:
# - json: local file store under LOCAL_DATA_DIR
# - prisma: PostgreSQL through Prisma Client
STORE_DRIVER=json
POSTGRES_PASSWORD=advivid
DATABASE_URL=postgresql://advivid:advivid@localhost:5432/advivid
REDIS_URL=redis://localhost:6379

# External dependency/runtime cache root for local downloads and service data.
# Keep database/cache/service data under E:\envment on Windows.
ENVMENT_DIR=E:/envment

# Queue:
# - local: API process runs long jobs directly, best for zero-setup demos
# - bullmq: API enqueues material/script/render jobs into Redis, apps/worker consumes them
QUEUE_DRIVER=local
RENDER_WORKER_CONCURRENCY=1

# Volcengine Ark / Seedance credentials. Never commit real values.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_ENDPOINT=
ARK_VIDEO_ENDPOINT=
ARK_TEXT_RETRIES=2
USE_MOCK_AI=true

# Video rendering:
# - auto: use Seedance only when USE_MOCK_AI=false and video credentials exist
# - seedance: always try Seedance first, then fall back to FFmpeg on failure
# - ffmpeg: always use local FFmpeg renderer
VIDEO_RENDER_PROVIDER=auto
SEEDANCE_RENDER_MODE=single
SEEDANCE_TOTAL_DURATION_SECONDS=20
SEEDANCE_SEGMENT_DURATION_SECONDS=5
SEEDANCE_MAX_SEGMENTS=4
SEEDANCE_IMAGE_INPUT_MODE=data_url
SEEDANCE_POST_COMPOSITE_MODE=auto
SEEDANCE_WAIT_SECONDS=420
SEEDANCE_POLL_SECONDS=8
SEEDANCE_TARGET_DURATION_SECONDS=5
